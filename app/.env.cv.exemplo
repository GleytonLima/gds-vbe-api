# Instancia do integrador para o ePHEM de Cabo Verde (API REST v2).
# No servidor (gds-vbe-api/), copie para app/.env.cv e preencha; nunca versione os valores.
# Ver a secao "Instancia de Cabo Verde" do README.

# o host e o nome do servico do banco no docker-compose; o banco e separado do da UnB
INTEGRACAO_DB_HOST=integracaodb
INTEGRACAO_DB_PORT=5432
INTEGRACAO_DB_SCHEMA_NAME=integracao_cv
INTEGRACAO_DB_USERNAME=
INTEGRACAO_DB_PASSWORD=

# XML-RPC: continua em uso para mensagens e consulta de status dos signals
ODOO_URL=https://cv.pheoc.com
ODOO_DB=cv
ODOO_USER=
ODOO_APIKEY=
# o ePHEM de Cabo Verde so tem pt_PT e en_US ativos
ODOO_LANG=pt_PT

# API REST v2: criacao dos signals
EPHEM_V2_ENABLED=true
EPHEM_V2_BASE_URL=https://cv.pheoc.com/api/v2
EPHEM_V2_API_KEY=
# precisa ser diferente entre instancias que publicam no mesmo ePHEM (ex.: homologacao: GDS-HOMOL-)
EPHEM_V2_EXTERNAL_ID_PREFIX=GDS-

LOGZIO_TOKEN=
# duas JVMs no mesmo host: limite a memoria de cada uma; mantenha o profile da UnB (app/.env)
JVM_OPTIONS=-Xmx384m -Dspring.profiles.active=prod
# o profile prod envia log ao Papertrail e nao sobe sem estas (copie do app/.env)
PAPERTRAIL_HOST=
PAPERTRAIL_PORT=
# canal proprio, para nao misturar os alertas com os da UnB
NOTIFYEVENTS_CHANNEL_URL=
